<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the app-PIN-encrypted structured-data snapshot is eligible. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="system-backup/finance.snapshot" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="system-backup/finance.snapshot" />
    </device-transfer>
</data-extraction-rules>
